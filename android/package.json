{
  "name": "parivartan-android",
  "private": true,
  "description": "Capacitor shell for Parivartan. The app code under www/ has no build step; npm is only used for Capacitor and the tests.",
  "scripts": {
    "sync-engine": "tools/sync-engine.sh",
    "test": "node test/render.test.js",
    "serve": "python3 -m http.server 8080 --directory www",
    "sync": "npm run sync-engine && npx cap sync android",
    "open": "npx cap open android",
    "build:debug": "JAVA_HOME=\"$(tools/find-jdk.sh)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\" sh -c 'cd android && ./gradlew assembleDebug'",
    "build:release": "JAVA_HOME=\"$(tools/find-jdk.sh)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\" sh -c 'cd android && ./gradlew bundleRelease'"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
